# Windows Host product defaults. Copy to host.env and edit machine values.
AI_RESCUE_API_HOST=0.0.0.0
AI_RESCUE_API_PORT=8000
AI_RESCUE_HOST_DATA=data/host
AI_RESCUE_HOST_WEB_ROOT=src/host/flutter_app/build/web
AI_RESCUE_LOG_DIR=data/logs

# Product default: pure Python Host UWB adapter. ROS 2 is not required.
AI_RESCUE_UWB_BRIDGE_MODE=serial
AI_RESCUE_UWB_SERIAL_PORT=
AI_RESCUE_UWB_BAUD=460800
AI_RESCUE_UWB_ROLE=host
AI_RESCUE_UWB_SPOOL=data/uwb_spool/host
AI_RESCUE_UWB_AUTO_DISCOVER=false

# Existing Stage 2 reliability tuning. Adjust only during Stage 5B measurements.
AI_RESCUE_UWB_FIRMWARE_ACK_TIMEOUT=2.0
AI_RESCUE_UWB_FIRMWARE_MAX_ATTEMPTS=3
AI_RESCUE_UWB_STORED_ACK_TIMEOUT=5.0
AI_RESCUE_UWB_APPLICATION_ACK_TIMEOUT=30.0
AI_RESCUE_UWB_SERIAL_SEND_TIMEOUT=20.0
AI_RESCUE_UWB_SEND_QUEUE_LIMIT=32
AI_RESCUE_UWB_RECONNECT_INITIAL_DELAY=0.25
AI_RESCUE_UWB_RECONNECT_MAX_DELAY=3.0
AI_RESCUE_UWB_RECONNECT_ATTEMPTS=6
AI_RESCUE_UWB_RECONNECT_COOLDOWN=5.0

# Host Flutter Web is served by Host FastAPI and uses same-origin by default.
# Flutter SDK is required only for build_web.ps1, not for normal runtime.
