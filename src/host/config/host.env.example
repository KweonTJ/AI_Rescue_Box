# Windows Host product defaults
AI_RESCUE_API_HOST=127.0.0.1
AI_RESCUE_API_PORT=8000
AI_RESCUE_HOST_DATA=data/host
AI_RESCUE_HOST_WEB_ROOT=src/host/flutter_app/build/web

# Keep the Host Backend/Web usable without ROS2/UWB hardware.
# Set to ros only on a machine where the existing Host UWB ROS bridge is available.
AI_RESCUE_UWB_BRIDGE_MODE=offline

# Optional Host UWB bridge settings for a real Windows/ROS2 setup.
AI_RESCUE_UWB_PORT=COM3
AI_RESCUE_UWB_BAUDRATE=460800
AI_RESCUE_UWB_SPOOL=data/uwb_spool
ROS_LOCALHOST_ONLY=1

# Host Flutter Web uses same-origin when served by Host FastAPI.
# For a separate development web server, build/run Flutter with:
# --dart-define=API_BASE_URL=http://127.0.0.1:8000

# Remote/demo servers are optional profiles and intentionally have no product default here.
