# Jetson local-only API/runtime. Copy to jetson.env and edit machine values.
AI_RESCUE_JETSON_API_HOST=0.0.0.0
AI_RESCUE_JETSON_API_PORT=8001
AI_RESCUE_DATA_ROOT=data/jetson
AI_RESCUE_LOG_DIR=data/logs/jetson

# Stage 3/4 analysis. Real mode never falls back to mock automatically.
AI_RESCUE_ANALYSIS_MODE=real
AI_RESCUE_JETSON_CONFIG=src/d_slam/config/default.yaml
AI_RESCUE_YOLO_MODEL=
AI_RESCUE_YOLO_CONFIDENCE=0.5
# Optional multi-class hazard model. Missing/empty keeps Person+Depth and rule risks working.
AI_RESCUE_HAZARD_MODEL=
AI_RESCUE_HAZARD_CONFIDENCE=0.5
# Optional JSON map from model class id to supported semantic name.
# AI_RESCUE_HAZARD_CLASS_MAP={"0":"person","1":"debris","2":"blocked_passage","3":"hole_or_drop","4":"stair_or_step"}
AI_RESCUE_DEPTH_MIN_M=0.15
AI_RESCUE_DEPTH_MAX_M=10.0
AI_RESCUE_SENSOR_SYNC_TOLERANCE_S=0.25

# Defaults match src/d_slam/d_slam/launch/d_slam.launch.py.
AI_RESCUE_RGB_TOPIC=/camera/color/image_raw
AI_RESCUE_DEPTH_TOPIC=/camera/depth/image_raw
AI_RESCUE_CAMERA_INFO_TOPIC=/camera/color/camera_info
AI_RESCUE_POINT_CLOUD_TOPIC=
AI_RESCUE_RTAB_MAP_TOPIC=/rtabmap/map
AI_RESCUE_RTAB_ODOM_TOPIC=/rtabmap/odom
AI_RESCUE_RTAB_POSE_TOPIC=/rtabmap/localization_pose
AI_RESCUE_RTAB_STATUS_TOPIC=/rtabmap/info
AI_RESCUE_SLAM_MAP_FRAME=map
AI_RESCUE_SLAM_ODOM_FRAME=odom
AI_RESCUE_RTAB_DATABASE=data/jetson/rtabmap.db
AI_RESCUE_DELETE_DB_ON_START=true

# Prior/live initial transform. Stage 4 bounded SE(2) search values are in
# AI_RESCUE_JETSON_CONFIG (default: src/d_slam/config/default.yaml).
AI_RESCUE_MISSION_TRANSFORM_MODE=initial_anchor
# AI_RESCUE_MISSION_TRANSFORM_X_M=0.0
# AI_RESCUE_MISSION_TRANSFORM_Y_M=0.0
# AI_RESCUE_MISSION_TRANSFORM_YAW_RAD=0.0

# Process switches used by deploy/jetson/start.sh.
AI_RESCUE_START_SLAM=true
AI_RESCUE_START_MISSION_SERVICE=true
AI_RESCUE_START_UWB=true
AI_RESCUE_START_STAGE2=true
AI_RESCUE_START_API=true
