{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rescue-box.local/interfaces/semantic_result.schema.json",
  "title": "Semantic Rescue Map Result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "mission_id", "base_map_version", "slam_map_version", "result_version", "artifact_version", "created_at", "coordinate_frame", "units", "source", "confidence", "robot_pose", "robot_trajectory", "victim_candidates", "confirmed_victims", "obstacles", "risk_zones", "entry_routes", "safe_waiting_points", "explored_areas", "unknown_areas", "team_recommendations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mission_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "base_map_version": {"type": "integer", "minimum": 1},
    "slam_map_version": {"type": "integer", "minimum": 1},
    "result_version": {"type": "integer", "minimum": 1},
    "artifact_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "coordinate_frame": {"const": "mission_map"},
    "units": {"enum": ["meters", "m"]},
    "source": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "analysis_mode": {"enum": ["real", "mock", "unknown"]},
    "robot_pose": {"$ref": "#/$defs/pose"},
    "robot_trajectory": {"type": "array", "items": {"$ref": "#/$defs/pose"}},
    "victim_candidates": {"type": "array", "items": {"type": "object"}},
    "confirmed_victims": {"type": "array", "items": {"type": "object"}},
    "obstacles": {"type": "array"},
    "risk_zones": {"type": "array", "items": {"type": "object"}},
    "blocked_passages": {"type": "array"},
    "change_regions": {"type": "array"},
    "traversability": {"type": "object"},
    "entry_routes": {"type": "array", "items": {"type": "object"}},
    "safe_waiting_points": {"type": "array"},
    "explored_areas": {"type": "array"},
    "prior_only_areas": {"type": "array"},
    "unknown_areas": {"type": "array"},
    "map_alignment": {"type": "object"},
    "team_recommendations": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "pose": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "yaw": {"type": "number"}}}
  }
}
