{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rescue-box.local/contracts/map_delta.schema.json",
  "title": "Semantic Map Delta",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "mission_id", "artifact_version", "base_result_version", "result_version", "created_at", "coordinate_frame", "source", "confidence", "changed_regions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mission_id": {"type": "string"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "base_result_version": {"type": "integer", "minimum": 1},
    "result_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "coordinate_frame": {"const": "mission_map"},
    "source": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "changed_regions": {"type": "array", "items": {"type": "object"}},
    "semantic_updates": {"type": "object"}
  }
}
