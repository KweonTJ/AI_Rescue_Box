# Jetson ESP32 USB serial. Do not commit a guessed /dev path.
AI_RESCUE_UWB_ROLE=jetson
AI_RESCUE_UWB_SERIAL_PORT=
AI_RESCUE_UWB_BAUD=460800
AI_RESCUE_UWB_SPOOL=data/uwb_spool/jetson
AI_RESCUE_UWB_AUTO_DISCOVER=false

# Existing Stage 2 protocol reliability settings.
AI_RESCUE_UWB_FIRMWARE_ACK_TIMEOUT=2.0
AI_RESCUE_UWB_FIRMWARE_MAX_ATTEMPTS=3
AI_RESCUE_UWB_STORED_ACK_TIMEOUT=5.0
AI_RESCUE_UWB_APPLICATION_ACK_TIMEOUT=30.0
AI_RESCUE_UWB_SERIAL_SEND_TIMEOUT=20.0
AI_RESCUE_UWB_SEND_QUEUE_LIMIT=32
AI_RESCUE_UWB_RECONNECT_INITIAL_DELAY=0.25
AI_RESCUE_UWB_RECONNECT_MAX_DELAY=3.0
AI_RESCUE_UWB_RECONNECT_ATTEMPTS=6
AI_RESCUE_UWB_RECONNECT_COOLDOWN=5.0
ROS_LOCALHOST_ONLY=1

# Offline Tablet network example. Runtime does not require this exact subnet.
AI_RESCUE_JETSON_IP=192.168.50.1
AI_RESCUE_HOTSPOT_CONNECTION=AI-Rescue-Box
AI_RESCUE_HOTSPOT_SSID=AI-Rescue-Box
AI_RESCUE_HOTSPOT_PASSWORD=
AI_RESCUE_HOTSPOT_INTERFACE=
AI_RESCUE_HOTSPOT_ADDRESS=192.168.50.1/24
