{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rescue-box.local/contracts/mission_manifest.schema.json",
  "title": "AI Rescue Box Mission Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "mission_id", "mission_version", "artifact_version", "mission_name", "created_at", "base_map", "meters_per_pixel", "robot_start", "entrances", "coordinate_frame", "units", "source", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mission_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "mission_version": {"type": "integer", "minimum": 1},
    "artifact_version": {"type": "integer", "minimum": 1},
    "mission_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "base_map": {
      "type": "object",
      "required": ["filename", "sha256", "width", "height"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[^/\\\\]+\\.(?i:png|jpe?g)$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "format": {"enum": ["PNG", "JPEG"]}
      }
    },
    "meters_per_pixel": {"type": "number", "exclusiveMinimum": 0},
    "robot_start": {"$ref": "#/$defs/pose"},
    "entrances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}},
    "available_teams": {"type": "integer", "minimum": 0},
    "available_rescuers": {"type": "integer", "minimum": 0},
    "coordinate_frame": {"const": "mission_map"},
    "units": {"enum": ["meters", "m"]},
    "source": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "coordinate_transform": {"type": "object"}
  },
  "$defs": {
    "point": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "pose": {"allOf": [{"$ref": "#/$defs/point"}], "type": "object", "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "yaw": {"type": "number"}}, "required": ["x", "y", "yaw"]}
  }
}
