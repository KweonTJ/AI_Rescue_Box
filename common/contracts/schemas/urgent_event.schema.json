{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rescue-box.local/contracts/urgent_event.schema.json",
  "title": "Urgent Rescue Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "mission_id", "artifact_version", "event_id", "event_type", "created_at", "coordinate_frame", "source", "confidence", "priority", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mission_id": {"type": "string"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["new_victim", "critical_risk", "route_blocked", "mission_error"]},
    "created_at": {"type": "string", "format": "date-time"},
    "coordinate_frame": {"const": "mission_map"},
    "source": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "priority": {"type": "integer", "minimum": 0, "maximum": 255},
    "payload": {"type": "object"}
  }
}
